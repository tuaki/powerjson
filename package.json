{
    "name": "powerjson",
    "version": "0.1.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tuaki/powerjson.git"
    },
    "keywords": [
        "json",
        "serialization",
        "deserialization",
        "stringify",
        "parse",
        "performance"
    ],
    "author": {
        "name": "Jáchym Bártík",
        "email": "jachymb32@gmail.com"
    },
    "license": "MIT",
    "type": "module",
    "files": [
        "dist",
        "README.md"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "build": "rm -rf dist && bun tsc -p tsconfig.build.json",
        "types": "bun tsc -p src/tsconfig.json && bun tsc -p tsconfig.json",
        "test": "bun test tests",
        "lint": "bun run eslint eslint.config.ts --fix",
        "benchmark": "bun run benchmarks/index.ts"
    },
    "dependencies": {},
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.5.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/bun": "^1.3.14",
        "@types/luxon": "^3.7.4",
        "@types/serialize-javascript": "^5.0.4",
        "cli-table3": "^0.6.5",
        "devalue": "^5.9.1",
        "eslint": "^10.6.0",
        "jiti": "^2.7.0",
        "luxon": "^3.7.2",
        "next-json": "^0.5.1",
        "serialize-javascript": "^7.1.0",
        "superjson": "^2.2.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    }
}
